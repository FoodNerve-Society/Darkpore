// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

// ════════════════════════════════════════════════════════
// USER MODEL
// ════════════════════════════════════════════════════════
model User {
  id          String  @id @default(cuid())
  firebaseUid String  @unique
  email       String  @unique
  username    String? @unique
  name        String
  firstName   String?
  lastName    String?
  prefixes    String? // JSON string array
  suffixes    String? // JSON string array
  avatarUrl   String?
  role        String  @default("member")

  // The 4-Tier Wallet
  lifetimeNP     Int @default(0)
  withdrawableNP Int @default(0)
  spendableNP    Int @default(0)
  promoNP        Int @default(0)

  rank Int @default(1)

  // Gatekeeper Flags
  hasCompletedProfile     Boolean   @default(false)
  hasKYC                  Boolean   @default(false)
  hasBusinessVerification Boolean   @default(false)
  verified                Boolean   @default(false)
  verifiedAt              DateTime?

  // Profile Data
  location          String?
  lga               String?
  specialization    String?
  subSector         String?
  bio               String?
  wahaalaCategories String? // Stored as JSON string or comma-separated
  tabOrder          String? // JSON array of ['trade', 'meet', 'learn', 'support']
  landingPage       String? // The default landing page role
  joinedAt          DateTime @default(now())

  // Relations
  tradeListings        TradeListing[]
  campaigns            Campaign[]
  organizationMembers  OrganizationMember[]
  communityMemberships CommunityGroupMember[]
  communityCards       CommunityCard[]
  conversations        ConversationParticipant[]
  sentMessages         Message[]
  subgroupMemberships  SubgroupParticipant[]
  followedInitiatives  SubgroupFollower[]
  pitchReviews         PitchReview[]
  communityPosts       CommunityPost[]
  omniWikiDocs         OmniWikiDoc[]
  wikiStates           UserWikiState[]

  @@index([email])
}

// ════════════════════════════════════════════════════════
// ORGANIZATION MODELS
// ════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  legalName String?
  cacNumber String?
  verified  Boolean  @default(false)
  rank      Int      @default(3) // Businesses start at Rank 3
  createdAt DateTime @default(now())
  logoUrl   String?
  country   String?
  state     String?
  lga       String?
  address   String?
  isVirtual Boolean  @default(false)
  isExternal Boolean @default(false)
  isPlatformOwner Boolean @default(false)
  challenges String? // JSON string array of challenge IDs
  subcategories String? // JSON string array of subcategory IDs

  // Relations
  members        OrganizationMember[]
  communityGroup CommunityGroup?
  tradeListings  TradeListing[]
  learnContent   LearnContent[]
  meetEvents     MeetEvent[]
  campaigns      Campaign[]
  wikiDocs       OmniWikiDoc[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("employee") // 'owner' | 'admin' | 'employee'
  department     String?
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// ════════════════════════════════════════════════════════
// SOCIETY OS MODELS
// ════════════════════════════════════════════════════════

model TradeListing {
  id              String    @id @default(cuid())
  category        String // 'group-buy' | 'flash-sale' | 'swap' | 'need' | 'jobs' | 'volunteer'
  title           String
  description     String
  commodity       String?
  quantity        String?
  priceOrAsk      String
  location        String
  lga             String
  expiresAt       DateTime?
  urgency         String    @default("normal") // 'normal' | 'urgent' | 'expiring'
  status          String    @default("active") // 'active' | 'fulfilled' | 'expired'
  slotsFilled     Int?
  slotsTotal      Int?
  swapOffer       String?
  swapWant        String?
  isBoosted       Boolean   @default(false)
  imageUrl        String?
  nervePointsCost Int?
  postedAt        DateTime  @default(now())

  // --- Job & Volunteer Classification Fields ---
  jobSource       String?   // 'internal_foodnerve' | 'verified_tenant' | 'admin_curated' | 'community_sourced'
  compType        String?   // 'fiat' | 'volunteer'
  targetTenantId  String?   // If verified_tenant, links to their profile
  externalUrl     String?   // Where to apply if external
  npReward        Int?      // How much NP the volunteer gets (Escrow)
  minRank         Int?      // Minimum rank required to apply (for Premium internal jobs)
  currency        String?
  minSalary       Float?
  maxSalary       Float?
  duration        String?
  startDate       DateTime?
  endDate         DateTime?
  workModel       String?   // 'remote' | 'hybrid' | 'onsite'
  jobFunction     String?   // E.g., 'Finance & Accounting', 'Agronomy'
  challenges      String?   // JSON string array of challenge IDs
  subcategories   String?   // JSON string array of subcategory IDs

  // --- Application & CTA Setup Fields ---
  applicationMethod       String   @default("native") // 'external' | 'native' | 'email'
  applicationEmail        String?  // If method is 'email'
  applicationInstructions String?  // If method is 'email', stores formatting instructions
  customQuestions         String?  // JSON array of objects if method is 'native'
  requiredDocuments       String?  // JSON array (e.g., ["resume", "coverLetter", "portfolio"])
  externalButtonText      String?  // Custom button text for external links

  // Relations
  postedById String
  postedBy   User   @relation(fields: [postedById], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model Campaign {
  id             String   @id @default(cuid())
  tier           String // 'initiative' | 'innovation' | 'venture'
  title          String
  description    String
  imageUrl       String?
  goalAmount     Float
  raisedAmount   Float    @default(0)
  backerCount    Int      @default(0)
  deadline       DateTime
  status         String   @default("funding") // 'funding' | 'active_deployment' | 'completed'
  originTag      String?
  tractionMetric String?
  createdAt      DateTime @default(now())

  // Relations
  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  initiativeId String?          @unique
  pitch        InitiativePitch? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
}

model MarketPrice {
  id            String   @id @default(cuid())
  commodity     String
  currentPrice  String
  previousPrice String
  unit          String
  change        Float
  region        String
  updatedAt     DateTime @updatedAt
}

model MeetEvent {
  id            String   @id @default(cuid())
  title         String
  type          String // 'webinar' | 'field-day' | 'workshop' | 'meetup'
  date          DateTime
  location      String
  attendees     Int      @default(0)
  maxAttendees  Int
  hostName      String
  hostAvatarUrl String?
  hostUserId    String?
  description   String
  imageUrl      String?
  isVirtual     Boolean  @default(false)
  status        String   @default("published") // 'published' | 'pending_org_review' | 'rejected'
  createdAt     DateTime @default(now())

  // Relations
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model LearnContent {
  id              String   @id @default(cuid())
  slug            String   @unique @default(cuid())
  type            String   @default("article") // 'livestream' | 'class' | 'video' | 'article' | 'report'
  status          String   @default("published") // 'draft' | 'published' | 'archived' | 'pending_org_review' | 'rejected'
  bottleneckTags  String   @default("[]") // JSON array of challenge tags (e.g. '["post-harvest-loss", "cold-chain"]')
  category        String?
  subcategory     String?
  timeframe       String?
  title           String
  description     String
  thumbnailUrl    String?
  authorId        String?
  authorName      String?
  authorAvatarUrl String?
  collaborators   String   @default("[]") // JSON array of collaborator objects { name, uid, role, timestamp }
  isVerified      Boolean  @default(false)
  isPaid          Boolean  @default(false)
  costNP          Int?
  views           Int      @default(0)
  likes           Int      @default(0)
  targetDate      DateTime? // The hype/deadline date used for Global Alerts
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  // Relations
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  article    LearnArticle?
  video      LearnVideo?
  class      LearnClass?
  livestream LearnLivestream?
  report     LearnReport?

  @@index([authorId, status])
  @@index([organizationId, status])
  @@index([type, status])
  @@index([targetDate])
}

model LearnArticle {
  id             String  @id @default(cuid())
  learnContentId String  @unique
  readTime       String?

  learnContent LearnContent        @relation(fields: [learnContentId], references: [id], onDelete: Cascade)
  blocks       LearnArticleBlock[]
}

model LearnArticleBlock {
  id         String @id @default(cuid())
  articleId  String
  orderIndex Int
  blockType  String // e.g. 'subheading', 'myth_fact', 'live_poll', 'core_interactive'
  content    String // JSON stringified payload specific to the blockType

  article LearnArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisions LearnArticleBlockRevision[]
  comments  BlockComment[]
}

model BlockComment {
  id          String   @id @default(cuid())
  blockId     String
  userId      String?  // null for anonymous users
  displayName String   @default("Anonymous")
  avatarUrl   String?
  text        String
  likes       Int      @default(0)
  parentId    String?  // for threaded replies
  createdAt   DateTime @default(now())

  block  LearnArticleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  parent BlockComment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies BlockComment[]   @relation("CommentReplies")

  @@index([blockId, createdAt])
  @@index([parentId])
}

model LearnArticleBlockRevision {
  id         String   @id @default(cuid())
  blockId    String
  editedBy   String   // The uid or ID of the user who made the edit
  oldContent String   // The state before the edit (JSON)
  newContent String   // The state after the edit (JSON)
  reason     String?
  createdAt  DateTime @default(now())

  block LearnArticleBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model LearnVideo {
  id             String  @id @default(cuid())
  learnContentId String  @unique
  videoUrl       String // Cloudinary / R2
  duration       String?

  learnContent LearnContent @relation(fields: [learnContentId], references: [id], onDelete: Cascade)
}

model LearnClass {
  id             String  @id @default(cuid())
  learnContentId String  @unique
  moduleCount    Int     @default(1)
  totalDuration  String?

  learnContent LearnContent @relation(fields: [learnContentId], references: [id], onDelete: Cascade)
}

model LearnLivestream {
  id             String    @id @default(cuid())
  learnContentId String    @unique
  streamUrl      String? // Cloudinary Live / Mux / R2
  isLive         Boolean   @default(false)
  scheduledFor   DateTime?

  learnContent LearnContent @relation(fields: [learnContentId], references: [id], onDelete: Cascade)
}

model LearnReport {
  id             String @id @default(cuid())
  learnContentId String @unique
  pdfUrl         String // Cloudflare R2 / Cloudinary
  pageCount      Int?

  learnContent LearnContent @relation(fields: [learnContentId], references: [id], onDelete: Cascade)
}

// ════════════════════════════════════════════════════════
// INNOVATIONS (CHALLENGES / CMS) MODELS
// ════════════════════════════════════════════════════════

model ChallengeUpdate {
  id               String   @id @default(cuid())
  title            String
  summary          String
  section          String // 'innovations' | 'community' | 'activities' | 'livestreams' | 'jobs' | 'library'
  importance       String   @default("normal") // 'high' | 'normal'
  linkText         String
  externalLink     String?
  subcategoryId    String
  subcategoryTitle String?
  date             DateTime @default(now())
}

model LearningMaterial {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  type             String // 'article' | 'video' | 'pdf'
  thumbnailUrl     String?
  previewText      String
  fullContent      String?
  isPremium        Boolean  @default(false)
  author           String?
  readTime         String?
  subcategoryId    String
  subcategoryTitle String?
  dateAdded        DateTime @default(now())
}

// ════════════════════════════════════════════════════════
// MEET PILLAR MODELS
// ════════════════════════════════════════════════════════

model Community {
  id          String   @id @default(cuid())
  roleKey     String   @unique // 'Student', 'Entrepreneur', 'Employee'
  displayName String
  createdAt   DateTime @default(now())

  groups CommunityGroup[]
}

model CommunityGroup {
  id             String   @id @default(cuid())
  communityId    String
  organizationId String?  @unique // Link to Organization if applicable (e.g. Unilag)
  name           String
  memberCount    Int      @default(0)
  createdAt      DateTime @default(now())

  community     Community              @relation(fields: [communityId], references: [id])
  organization  Organization?          @relation(fields: [organizationId], references: [id])
  members       CommunityGroupMember[]
  cards         CommunityCard[]
  communityPosts CommunityPost[]
  conversations Conversation[]
}

model CommunityGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model DailySparkQuestion {
  id              String  @id @default(cuid())
  questionText    String
  sourceArticleId String? // Link to the original LearnContent if applicable

  // Category Tagging for the dynamic knowledge base filter
  category    String
  subcategory String
  era         String?

  scheduledDate DateTime @unique // The day this question goes live globally
  isProcessed   Boolean  @default(false) // Set to true at midnight when subgroups are spawned
  createdAt     DateTime @default(now())

  // Relations
  cards CommunityCard[]
}

model CommunityCard {
  id           String @id @default(cuid())
  groupId      String // The CommunityGroup this belongs to
  authorId     String
  dailySparkId String // Links back to the question of the day

  // Engagement Metrics for threshold triggering
  likes    Int @default(0)
  dislikes Int @default(0)
  views    Int @default(0)

  hasSpawnedSubgroup Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Relations
  group      CommunityGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author     User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  dailySpark DailySparkQuestion   @relation(fields: [dailySparkId], references: [id], onDelete: Cascade)
  blocks     CommunityCardBlock[] // The 9 Intelligence Blocks that make up the card content
  initiative SubgroupInitiative? // 1-to-1 link if this card spawns a subgroup
}

model CommunityCardBlock {
  id         String @id @default(cuid())
  cardId     String
  orderIndex Int
  blockType  String // e.g. 'deep_analysis', 'myth_fact', 'live_poll'
  content    String // JSON stringified payload

  card CommunityCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model CommunityPost {
  id          String   @id @default(cuid())
  groupId     String
  authorId    String
  category    String
  subcategory String
  likes       Int      @default(0)
  createdAt   DateTime @default(now())

  group  CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  blocks CommunityPostBlock[]
}

model CommunityPostBlock {
  id         String @id @default(cuid())
  postId     String
  orderIndex Int
  blockType  String
  content    String

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model SubgroupInitiative {
  id           String @id @default(cuid())
  sourceCardId String @unique // The viral card that spawned this
  groupId      String // Inherited community

  // 'ideation' -> 'consensus' -> 'review' -> 'graduated' | 'failed'
  status    String   @default("ideation")
  createdAt DateTime @default(now())

  // Relations
  sourceCard   CommunityCard         @relation(fields: [sourceCardId], references: [id], onDelete: Cascade)
  participants SubgroupParticipant[]
  followers    SubgroupFollower[]
  questions    ConsensusQuestion[]
  pitch        InitiativePitch?
}

model SubgroupParticipant {
  id           String @id @default(cuid())
  initiativeId String
  userId       String

  // 'active', 'kicked', 'left'
  status   String    @default("active")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  initiative SubgroupInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  votes ConsensusVote[]

  @@unique([initiativeId, userId])
}

model SubgroupFollower {
  id           String   @id @default(cuid())
  initiativeId String
  userId       String
  followedAt   DateTime @default(now())

  initiative SubgroupInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, userId])
}

model ConsensusQuestion {
  id           String @id @default(cuid())
  initiativeId String
  orderIndex   Int // 1 to 25
  questionText String

  proposedAnswer String? // The draft answer they are working on
  status         String  @default("active") // 'active' | 'passed'

  startedAt DateTime  @default(now())
  passedAt  DateTime?

  initiative SubgroupInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  votes      ConsensusVote[]
}

model ConsensusVote {
  id            String @id @default(cuid())
  questionId    String
  participantId String
  voteStatus    String // 'agree' | 'disagree'

  question    ConsensusQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant SubgroupParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([questionId, participantId])
}

model InitiativePitch {
  id           String @id @default(cuid())
  initiativeId String @unique
  title        String
  summary      String

  // 'pending', 'approved', 'rejected'
  status    String   @default("pending")
  createdAt DateTime @default(now())

  initiative SubgroupInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  reviews    PitchReview[]

  // Once graduated, it links to a final Campaign on the Support Tab
  campaign Campaign?
}

model PitchReview {
  id         String @id @default(cuid())
  pitchId    String
  reviewerId String // Must be a Rank 4 or 5 User

  vote     String // 'approve' | 'reject'
  feedback String // Their actionable advice

  // The accountability loop:
  isHelpful Boolean? // Null until rated by the founders
  ratedAt   DateTime?

  pitch    InitiativePitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  reviewer User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([pitchId, reviewerId])
}

// ════════════════════════════════════════════════════════
// MESSAGING MODELS (Phase 3)
// ════════════════════════════════════════════════════════

model Conversation {
  id        String   @id @default(cuid())
  // DMs will have no groupId. Group chats will have a groupId.
  groupId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group        CommunityGroup?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  hasUnread      Boolean  @default(false)
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String?
  images         String? // JSON stringified array of URLs
  status         String   @default("sent") // 'sent' | 'delivered' | 'read'
  type           String? // 'system' | 'application_request' etc.
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ════════════════════════════════════════════════════════
// OMNI-WIKI MODELS
// ════════════════════════════════════════════════════════

model OmniWikiDoc {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String
  status       String   @default("published") // 'published' | 'pending_org_review' | 'rejected' | 'draft'
  
  // Document-Level Access Control
  isPublic     Boolean  @default(false)
  allowedRoles String   @default("[]") // JSON Array: ["internal_staff", "admin"]
  allowedUsers String   @default("[]") // JSON Array: ["uid1", "uid2"]

  // The Content
  blocks       String   @default("[]") // JSON stringified array of WikiBlock objects
  
  // Metadata
  parentId     String?
  hotspotId    String?  @unique
  tags         String   @default("[]") // JSON stringified array of tags
  authorId     String
  organizationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  parent       OmniWikiDoc?  @relation("WikiHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     OmniWikiDoc[] @relation("WikiHierarchy")
  
  userStates   UserWikiState[]

  @@index([category])
  @@index([organizationId])
}

model UserWikiState {
  id        String   @id @default(cuid())
  wikiDocId String
  userId    String
  
  // Stored block state (JSON strings)
  checkboxes   String @default("{}")
  promptInputs String @default("{}")
  scratchpads  String @default("{}")
  scrollPosition Int  @default(0)
  
  updatedAt DateTime @updatedAt
  
  wikiDoc OmniWikiDoc @relation(fields: [wikiDocId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([wikiDocId, userId])
}

model WikiHotspotRegistry {
  id          String   @id // The exact Hotspot ID used by the developer
  label       String
  description String?
  category    String?
  subcategory String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
